# Maintainer: ShieldRed 5 Maintainers
pkgname=shieldred5
pkgver=1.1.2
pkgrel=1
pkgdesc="Multi-boot USB preparation utility and offline Plugson configurator (Red Ninja Hardened Edition)"
arch=('any')
license=('GPL-3.0-only')
depends=('bash' 'parted' 'dosfstools' 'exfatprogs' 'xz' 'python' 'util-linux')
optdepends=('nodejs: run the cross-platform shieldred5-plugson web configurator')
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=('SKIP')

package() {
  cd "${srcdir}/${pkgname}-${pkgver}" 2>/dev/null || cd "${startdir}/../.."
  bash ./install.sh --prefix /usr --destdir "${pkgdir}"
}

